@siteUrl = http://localhost:3000
@baseUrl = http://127.0.0.1:3001
@sessionId = replace-with-session-id
@contextId = replace-with-current-context-id
@historyContextId = replace-with-history-context-id
@visitorCookie = replace-with-signed-cookie
@adminSession = replace-with-management-session-cookie
@runId = replace-with-run-id

### Browser-facing session (response sets an HttpOnly anonymous cookie)
POST {{siteUrl}}/api/agent/sessions
Content-Type: application/json
x-cooyue-agent: 1

{"locale":"zh"}

### SSE search; use a new requestId for each new turn, same ID only for retry
POST {{siteUrl}}/api/agent/sessions/{{sessionId}}/messages
Content-Type: application/json
x-cooyue-agent: 1
Cookie: cooyue_agent_visitor={{visitorCookie}}

{"requestId":"360d0cab-af46-42ad-bf39-6c5f9a14dd53","contextId":"{{contextId}}","message":"我要找用于甲烷巡检的手持设备，帮我对比候选"}

### New context, preserving browser identity, history, retention and usage limits
POST {{siteUrl}}/api/agent/sessions/{{sessionId}}/contexts
Content-Type: application/json
x-cooyue-agent: 1
Cookie: cooyue_agent_visitor={{visitorCookie}}

{"contextId":"{{contextId}}"}

### Remember an owned conversation; does not cancel runs or lock other contexts
POST {{siteUrl}}/api/agent/sessions/{{sessionId}}/contexts/{{historyContextId}}/activate
Content-Type: application/json
x-cooyue-agent: 1
Cookie: cooyue_agent_visitor={{visitorCookie}}

{"contextId":"{{contextId}}"}

### All retained turns (10 total) and context titles; cache and render only the selected context
GET {{siteUrl}}/api/agent/sessions/{{sessionId}}
x-cooyue-agent: 1
Cookie: cooyue_agent_visitor={{visitorCookie}}

### A second context may search concurrently; max 2 per visitor, one per context
POST {{siteUrl}}/api/agent/sessions/{{sessionId}}/messages
Content-Type: application/json
x-cooyue-agent: 1
Cookie: cooyue_agent_visitor={{visitorCookie}}

{"requestId":"5485a58c-0bb4-4d51-a749-bcb0c1382fd2","contextId":"{{historyContextId}}","message":"LE"}

### Published news feed; no credentials and no draft/private content
GET {{siteUrl}}/api/agent-content?locale=zh

### Protected admin analytics
GET {{baseUrl}}/api/agent/admin/runs?page=1&pageSize=20
Cookie: cooyue_admin_session={{adminSession}}

### Protected embedding details: metrics.embedding includes coverage, hits, scores, latency and safe errors; no raw vectors or credentials
GET {{baseUrl}}/api/agent/admin/runs/{{runId}}
Cookie: cooyue_admin_session={{adminSession}}

### Must reject anonymous access
GET {{baseUrl}}/api/agent/admin/runs

### Must reject destructive methods
DELETE {{siteUrl}}/api/agent/sessions/{{sessionId}}
x-cooyue-agent: 1
